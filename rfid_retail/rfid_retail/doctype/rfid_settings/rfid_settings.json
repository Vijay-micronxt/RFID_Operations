 "fields": [
  {
   "fieldname": "rfid_tab",
   "fieldtype": "Tab Break",
   "label": "RFID"
  },
  {
   "default": "0",
   "description": "RFID master switch. When off no RFID rule runs: no invoice checks, no stations, no scheduled alerts. Item codes and labels have their own switches on the other tabs.",
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enable RFID"
  },
  {
   "fieldname": "sale_section",
   "fieldtype": "Section Break",
   "label": "Sale rules"
  },
  {
   "default": "1",
   "description": "Off: only grouped sets need a counter read; single tagged garments may be billed by picking the serial.",
   "fieldname": "require_scan_for_sale",
   "fieldtype": "Check",
   "label": "Every RFID-tracked unit must be read at an RFID counter before billing"
  },
  {
   "default": "1",
   "description": "Piece/serial labels count as a read and are logged as Barcode Fallback exceptions.",
   "fieldname": "allow_label_fallback",
   "fieldtype": "Check",
   "label": "Accept printed labels when a tag cannot be read"
  },
  {
   "default": "0",
   "description": "On: nothing can be sold unless it carries an RFID identity.",
   "fieldname": "block_untracked_items",
   "fieldtype": "Check",
   "label": "Block stock items that are not RFID tracked"
  },
  {
   "fieldname": "cb_sale",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "tag_release_mode",
   "fieldtype": "Select",
   "label": "After A Sale",
   "options": "Free the tag at once\nFree the tag after removal at the detach station",
   "default": "Free the tag at once",
   "description": "At once: the tag is reusable as soon as the bill is paid. After removal: it stays linked to the sold garment until it is read at the detach station."
  },
  {
   "fieldname": "inward_section",
   "fieldtype": "Section Break",
   "label": "Purchase And Stock In"
  },
  {
   "fieldname": "require_tags_on_inward",
   "fieldtype": "Check",
   "label": "Tag Every Unit Before Submitting",
   "default": "0",
   "description": "Purchase Invoice / Purchase Receipt / Stock Entry cannot be submitted until every RFID unit on it has a tag. Off: untagged units wait in the Tag garments station."
  },
  {
   "fieldname": "device_section",
   "fieldtype": "Section Break",
   "label": "Devices and daily checks"
  },
  {
   "default": "15",
   "fieldname": "device_offline_minutes",
   "fieldtype": "Int",
   "label": "Mark a device offline after (minutes)"
  },
  {
   "default": "1",
   "fieldname": "exit_gate_enabled",
   "fieldtype": "Check",
   "label": "Exit gate in use"
  },
  {
   "fieldname": "cb1",
   "fieldtype": "Column Break"
  },
  {
   "default": "1",
   "description": "Raises a Missed Audit exception at 23:00 when no count was compared that day.",
   "fieldname": "daily_audit_required",
   "fieldtype": "Check",
   "label": "Daily handheld count required"
  },
  {
   "description": "Who may use each station. System Manager always can. A station with no rows is closed to everyone else.",
   "fieldname": "access_section",
   "fieldtype": "Section Break",
   "label": "Station access"
  },
  {
   "fieldname": "station_roles",
   "fieldtype": "Table",
   "label": "Station Roles",
   "options": "RFID Station Role"
  },
  {
   "fieldname": "item_code_tab",
   "fieldtype": "Tab Break",
   "label": "Item Codes"
  },
  {
   "default": "0",
   "fieldname": "item_codes_enabled",
   "fieldtype": "Check",
   "label": "Build item codes and names from patterns",
   "description": "Works with RFID switched off. Applies when an item is created with Item Code left blank, and to every new variant."
  },
  {
   "fieldname": "item_code_section",
   "fieldtype": "Section Break",
   "label": "Patterns",
   "depends_on": "item_codes_enabled"
  },
  {
   "default": "{supplier_code}-{item_name}",
   "fieldname": "item_code_pattern",
   "fieldtype": "Data",
   "label": "Item code",
   "mandatory_depends_on": "item_codes_enabled"
  },
  {
   "default": "{template}-{attr_abbrs}",
   "fieldname": "variant_code_pattern",
   "fieldtype": "Data",
   "label": "Variant code",
   "mandatory_depends_on": "item_codes_enabled"
  },
  {
   "fieldname": "cb_codes",
   "fieldtype": "Column Break"
  },
  {
   "default": "{item_name}",
   "fieldname": "item_name_pattern",
   "fieldtype": "Data",
   "label": "Item name",
   "mandatory_depends_on": "item_codes_enabled"
  },
  {
   "default": "{template_name} {attr_values}",
   "fieldname": "variant_name_pattern",
   "fieldtype": "Data",
   "label": "Variant name",
   "mandatory_depends_on": "item_codes_enabled"
  },
  {
   "fieldname": "code_format_section",
   "fieldtype": "Section Break",
   "label": "Code format",
   "depends_on": "item_codes_enabled"
  },
  {
   "default": "-",
   "fieldname": "code_separator",
   "fieldtype": "Data",
   "label": "Separator between words in a code",
   "length": 1
  },
  {
   "default": "1",
   "fieldname": "code_uppercase",
   "fieldtype": "Check",
   "label": "Upper-case codes"
  },
  {
   "fieldname": "cb_format",
   "fieldtype": "Column Break"
  },
  {
   "default": "3",
   "fieldname": "supplier_code_length",
   "fieldtype": "Int",
   "label": "Supplier code length",
   "description": "Used when the supplier has no Item Code Prefix: first letters of the supplier name."
  },
  {
   "default": "0",
   "fieldname": "item_name_code_length",
   "fieldtype": "Int",
   "label": "Max letters of item name in a code",
   "description": "0 = whole name."
  },
  {
   "fieldname": "pattern_help",
   "fieldtype": "HTML",
   "label": "Tokens",
   "depends_on": "item_codes_enabled",
   "options": "<p class='text-muted small'>Tokens: <code>{supplier_code}</code> <code>{supplier}</code> <code>{item_name}</code> <code>{item_group}</code> <code>{brand}</code> <code>{style_code}</code> <code>{template}</code> <code>{template_name}</code> <code>{attr_abbrs}</code> <code>{attr_values}</code> <code>{attr:Colour}</code> (abbreviation) <code>{value:Colour}</code> (value) <code>{###}</code> (running number per prefix). Empty tokens are dropped together with their separator.</p>"
  },
  {
   "fieldname": "label_tab",
   "fieldtype": "Tab Break",
   "label": "Barcodes & Labels"
  },
  {
   "default": "0",
   "fieldname": "barcodes_enabled",
   "fieldtype": "Check",
   "label": "Create a barcode for every new stock item",
   "description": "Works with RFID switched off. Items that already carry a barcode (e.g. the supplier's) keep it."
  },
  {
   "default": "EAN-13",
   "depends_on": "barcodes_enabled",
   "fieldname": "barcode_kind",
   "fieldtype": "Select",
   "label": "Barcode type",
   "options": "EAN-13\nNumeric\nItem Code"
  },
  {
   "default": "2",
   "depends_on": "eval:doc.barcodes_enabled && doc.barcode_kind!='Item Code'",
   "fieldname": "barcode_prefix",
   "fieldtype": "Data",
   "label": "Barcode prefix",
   "description": "EAN-13: 2x is the in-store range; use your GS1 company prefix if you have one."
  },
  {
   "fieldname": "cb_barcode",
   "fieldtype": "Column Break"
  },
  {
   "default": "0",
   "fieldname": "auto_label_job",
   "fieldtype": "Check",
   "label": "Prepare a Label Print Job when stock is received",
   "description": "Purchase Receipt, Purchase Invoice with Update Stock, and Stock Entry receipts."
  },
  {
   "fieldname": "label_copies",
   "fieldtype": "Select",
   "label": "Label Copies From A Document",
   "options": "Enter by hand\nReceived quantity",
   "default": "Enter by hand",
   "description": "Enter by hand: items without serial numbers start at 0 copies and the user types how many stickers to print. Serial items always get one label per piece."
  },
  {
   "default": "0",
   "fieldname": "component_labels",
   "fieldtype": "Check",
   "label": "Also print a label for each set piece",
   "description": "Garment sets: one durable label per jacket/trouser/etc. so a return can be matched after tags are removed."
  },
